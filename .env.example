# ---------------------------------------------------------------------------
# Local development. Copy to .env and fill in. Never commit .env.
# In Cloud Run these come from the environment and Secret Manager instead.
# ---------------------------------------------------------------------------

# Where output goes: local | gcs
OWC_TARGET=local
OWC_ENV=dev

# Snowflake — the Lightcast reader account.
# In Cloud Run only SNOWFLAKE_PASSWORD comes from Secret Manager; the rest
# are plain env vars on the job.
SNOWFLAKE_ACCOUNT=EMSIBG-READER_TULSA_FOR_YOU
SNOWFLAKE_USER=""
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_WAREHOUSE=TULSA_FOR_YOU_WH
SNOWFLAKE_DATABASE=LIGHTCAST
SNOWFLAKE_SCHEMA=TULSA_FOR_YOU

# GCP — only needed when OWC_TARGET=gcs
# OWC_GCP_PROJECT=owc-data-dev
# OWC_GCS_RAW_BUCKET=okw-raw-dev
# OWC_BQ_STAGING_DATASET=owc_staging
# OWC_BQ_MARTS_DATASET=owc_marts
# OWC_BQ_OPS_DATASET=owc_ops
# OWC_BQ_LOCATION=US

# Enrollment state dir. Locally this defaults to a separate directory from
# the GCS-backed production cache so a local test cannot corrupt it.
# OWC_ENROLLMENT_DATA_DIR=.owcdata-local/enrollment/data
